{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/reference-catalog/1.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_id",
    "version",
    "as_of",
    "default_authority",
    "sources"
  ],
  "properties": {
    "catalog_id": {
      "const": "VS-REFERENCE-CATALOG"
    },
    "version": {
      "const": "1.8.0"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "default_authority": {
      "const": "ADVISORY"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "source_type",
          "source_status",
          "stages",
          "usage_note",
          "reviewed_at",
          "review_trigger"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "source_type": {
            "enum": [
              "OFFICIAL",
              "OPEN_STANDARD",
              "INDUSTRY_GUIDANCE",
              "VENDOR_GUIDANCE",
              "COMMUNITY",
              "TECH_RADAR"
            ]
          },
          "source_status": {
            "enum": [
              "ACTIVE",
              "ARCHIVED",
              "DRAFT",
              "SUPERSEDED",
              "UNKNOWN"
            ]
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "usage_note": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_trigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
