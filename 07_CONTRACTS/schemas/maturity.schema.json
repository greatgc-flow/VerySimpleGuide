{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/maturity/1.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PLANNED",
              "DESIGN_FROZEN",
              "IMPLEMENTING",
              "IMPLEMENTED",
              "VERIFIED",
              "DEPRECATED",
              "RETIRED"
            ]
          },
          "candidate_identity": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "\\S"
          },
          "required_gate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "gate-evidence.schema.json"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "VERIFIED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "candidate_identity",
                "verified_at",
                "artifact_digest",
                "required_gate_ids",
                "gates"
              ],
              "properties": {
                "candidate_identity": {
                  "type": "string",
                  "minLength": 1
                },
                "verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
