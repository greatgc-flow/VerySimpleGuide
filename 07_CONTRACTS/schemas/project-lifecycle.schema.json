{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/project-lifecycle/1.9",
  "title": "Project Lifecycle Applicability and Disposition Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "scope",
    "profile",
    "escalation_flags",
    "activity_flags",
    "exposure_flags",
    "stages",
    "concerns"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "COMPACT",
        "FULL"
      ]
    },
    "escalation_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_contract_change",
        "authoritative_data",
        "security_boundary",
        "external_dependency"
      ],
      "properties": {
        "public_contract_change": {
          "type": "boolean"
        },
        "authoritative_data": {
          "type": "boolean"
        },
        "security_boundary": {
          "type": "boolean"
        },
        "external_dependency": {
          "type": "boolean"
        }
      }
    },
    "activity_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "distribution",
        "supported_operation",
        "compat_or_data_transition",
        "withdrawal"
      ],
      "properties": {
        "code": {
          "type": "boolean"
        },
        "distribution": {
          "type": "boolean"
        },
        "supported_operation": {
          "type": "boolean"
        },
        "compat_or_data_transition": {
          "type": "boolean"
        },
        "withdrawal": {
          "type": "boolean"
        }
      }
    },
    "exposure_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_interaction",
        "personal_or_sensitive_data",
        "dependencies",
        "distribution",
        "operation",
        "material_resource_commitments"
      ],
      "properties": {
        "human_interaction": {
          "type": "boolean"
        },
        "personal_or_sensitive_data": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "boolean"
        },
        "distribution": {
          "type": "boolean"
        },
        "operation": {
          "type": "boolean"
        },
        "material_resource_commitments": {
          "type": "boolean"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/disposition_record"
          }
        ],
        "required": [
          "stage_id",
          "applicability",
          "approach",
          "result",
          "deferred",
          "owner",
          "reason",
          "revisit_trigger",
          "acceptance_criteria",
          "candidate_identity",
          "evidence_refs"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {},
          "approach": {},
          "result": {},
          "deferred": {},
          "owner": {},
          "reason": {},
          "revisit_trigger": {},
          "acceptance_criteria": {},
          "candidate_identity": {},
          "evidence_refs": {}
        },
        "additionalProperties": false
      }
    },
    "concerns": {
      "type": "array",
      "minItems": 4,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/disposition_record"
          }
        ],
        "required": [
          "concern_id",
          "applicability",
          "approach",
          "result",
          "deferred",
          "owner",
          "reason",
          "revisit_trigger",
          "acceptance_criteria",
          "candidate_identity",
          "evidence_refs"
        ],
        "properties": {
          "concern_id": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {},
          "approach": {},
          "result": {},
          "deferred": {},
          "owner": {},
          "reason": {},
          "revisit_trigger": {},
          "acceptance_criteria": {},
          "candidate_identity": {},
          "evidence_refs": {}
        },
        "additionalProperties": false
      }
    },
    "cell_overrides": {
      "type": "array",
      "default": [],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/disposition_record"
          }
        ],
        "required": [
          "stage_id",
          "concern_id",
          "applicability",
          "approach",
          "result",
          "deferred",
          "owner",
          "reason",
          "revisit_trigger",
          "acceptance_criteria",
          "candidate_identity",
          "evidence_refs"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "concern_id": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {},
          "approach": {},
          "result": {},
          "deferred": {},
          "owner": {},
          "reason": {},
          "revisit_trigger": {},
          "acceptance_criteria": {},
          "candidate_identity": {},
          "evidence_refs": {}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "disposition_record": {
      "type": "object",
      "properties": {
        "applicability": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "N_A"
          ]
        },
        "approach": {
          "enum": [
            "COMPLY",
            "ADAPT",
            "PRODUCT_SPECIFIC"
          ]
        },
        "result": {
          "enum": [
            "NOT_EVALUATED",
            "PASS",
            "FAIL"
          ]
        },
        "deferred": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "revisit_trigger": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "string"
        },
        "candidate_identity": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feedback_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "trigger_observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "applicability": {
                "enum": [
                  "REQUIRED",
                  "OPTIONAL"
                ]
              },
              "deferred": {
                "const": false
              },
              "acceptance_criteria": {
                "minLength": 1
              },
              "candidate_identity": {
                "minLength": 1
              },
              "evidence_refs": {
                "minItems": 1
              },
              "revisit_trigger": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "N_A"
              }
            },
            "required": [
              "applicability"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "const": "NOT_EVALUATED"
              },
              "reason": {
                "minLength": 1
              },
              "revisit_trigger": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deferred": {
                "const": true
              }
            },
            "required": [
              "deferred"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "enum": [
                  "NOT_EVALUATED",
                  "FAIL"
                ]
              },
              "reason": {
                "minLength": 1
              },
              "revisit_trigger": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approach": {
                "const": "ADAPT"
              }
            },
            "required": [
              "approach"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1
              },
              "acceptance_criteria": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "FAIL"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "feedback_ids",
              "trigger_observation_ids"
            ]
          }
        }
      ]
    }
  }
}
