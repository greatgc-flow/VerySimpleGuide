{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/manifest/1.8",
  "title": "Package File Inventory and Artifact Authority Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package",
    "standard_version",
    "files"
  ],
  "properties": {
    "package": {
      "const": "VerySimpleGuide"
    },
    "standard_version": {
      "const": "1.8.0"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "role",
          "primary_control",
          "related_controls"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "NORMATIVE_SOURCE",
              "MACHINE_SSOT",
              "HUMAN_GUIDE",
              "GENERATED_VIEW",
              "EXAMPLE",
              "REFERENCE_CATALOG",
              "ASSURANCE_EVIDENCE",
              "VALIDATION_TOOL"
            ]
          },
          "primary_control": {
            "type": "string",
            "pattern": "^UPS-[A-Z]+$"
          },
          "related_controls": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^UPS-[A-Z]+$"
            }
          }
        }
      }
    }
  }
}
