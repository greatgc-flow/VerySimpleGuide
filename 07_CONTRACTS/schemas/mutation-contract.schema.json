{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/mutation-contract/1.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "idempotency",
    "retry",
    "crash_boundary",
    "concurrency",
    "uncertain_execution"
  ],
  "properties": {
    "operation": {
      "type": "string"
    },
    "idempotency": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "N_A"
      ]
    },
    "retry": {
      "enum": [
        "SAFE",
        "CONDITIONAL",
        "FORBIDDEN",
        "N_A"
      ]
    },
    "crash_boundary": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "N_A"
      ]
    },
    "rollback": {
      "enum": [
        "REQUIRED",
        "COMPENSATION",
        "N_A"
      ]
    },
    "concurrency": {
      "enum": [
        "SERIALIZED",
        "CAS_REVISION",
        "FENCED",
        "COMMUTATIVE",
        "N_A"
      ]
    },
    "uncertain_execution": {
      "enum": [
        "RECONCILE",
        "BLOCK_RETRY",
        "N_A"
      ]
    }
  }
}
