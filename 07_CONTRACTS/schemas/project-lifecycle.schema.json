{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/project-lifecycle/1.7",
  "title": "Project Lifecycle Applicability and Disposition Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "scope",
    "stages",
    "concerns"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/disposition_record"
          }
        ],
        "required": [
          "stage_id",
          "status",
          "owner",
          "reason",
          "revisit_trigger",
          "evidence_refs"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {},
          "owner": {},
          "reason": {},
          "revisit_trigger": {},
          "evidence_refs": {}
        },
        "additionalProperties": false
      }
    },
    "concerns": {
      "type": "array",
      "minItems": 10,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/disposition_record"
          }
        ],
        "required": [
          "concern_id",
          "status",
          "owner",
          "reason",
          "revisit_trigger",
          "evidence_refs"
        ],
        "properties": {
          "concern_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {},
          "owner": {},
          "reason": {},
          "revisit_trigger": {},
          "evidence_refs": {}
        },
        "additionalProperties": false
      }
    },
    "cell_overrides": {
      "type": "array",
      "default": [],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/disposition_record"
          }
        ],
        "required": [
          "stage_id",
          "concern_id",
          "status",
          "owner",
          "reason",
          "revisit_trigger",
          "evidence_refs"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "concern_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {},
          "owner": {},
          "reason": {},
          "revisit_trigger": {},
          "evidence_refs": {}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "disposition_record": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "N_A",
            "DEFERRED",
            "PASS"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "revisit_trigger": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "N_A",
                  "DEFERRED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1
              },
              "revisit_trigger": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
