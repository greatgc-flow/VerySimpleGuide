{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "provider_id",
    "capabilities"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object"
    },
    "declaration_semantics": {
      "const": "DECLARED_NOT_MEASURED"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
