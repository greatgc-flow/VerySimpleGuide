{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "artifact_identity",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_PUBLISHED",
              "CANDIDATE",
              "PUBLISHED",
              "PROMOTED",
              "WITHDRAWN"
            ]
          },
          "artifact_identity": {
            "type": "string",
            "minLength": 1
          },
          "verification_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PROMOTED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "verification_ref"
              ],
              "properties": {
                "verification_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
