{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "scope",
    "stages",
    "concerns"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "status",
          "owner",
          "reason",
          "revisit_trigger",
          "evidence_refs"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "N_A",
              "DEFERRED",
              "PASS"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "revisit_trigger": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "N_A",
                    "DEFERRED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "minLength": 1
                },
                "revisit_trigger": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "concerns": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern_id",
          "status",
          "owner",
          "reason",
          "revisit_trigger",
          "evidence_refs"
        ],
        "properties": {
          "status": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "N_A",
              "DEFERRED",
              "PASS"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "revisit_trigger": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "concern_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "N_A",
                    "DEFERRED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "minLength": 1
                },
                "revisit_trigger": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "cell_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "concern_id",
          "status",
          "owner",
          "reason",
          "revisit_trigger",
          "evidence_refs"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "concern_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "N_A",
              "DEFERRED",
              "PASS"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "revisit_trigger": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "N_A",
                    "DEFERRED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "minLength": 1
                },
                "revisit_trigger": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "default": []
    }
  }
}
