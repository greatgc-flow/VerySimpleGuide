{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/guidance-catalog/1.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_id",
    "version",
    "selection_policy",
    "default_normative_level",
    "guidance"
  ],
  "properties": {
    "catalog_id": {
      "const": "VS-OPTIONAL-GUIDANCE"
    },
    "version": {
      "const": "1.7.0"
    },
    "selection_policy": {
      "const": "PULL_ON_DEMAND"
    },
    "default_normative_level": {
      "const": "EXAMPLE_REFERENCE"
    },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "stage_ids",
          "concern_ids",
          "applicability",
          "problem",
          "use_when",
          "avoid_when",
          "technique",
          "tradeoffs",
          "alternatives",
          "reference_ids",
          "evidence_strategy",
          "review_trigger"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "stage_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "concern_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "applicability": {
            "const": "OPTIONAL"
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "use_when": {
            "type": "string",
            "minLength": 1
          },
          "avoid_when": {
            "type": "string",
            "minLength": 1
          },
          "technique": {
            "type": "string",
            "minLength": 1
          },
          "tradeoffs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_strategy": {
            "type": "string",
            "minLength": 1
          },
          "review_trigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
