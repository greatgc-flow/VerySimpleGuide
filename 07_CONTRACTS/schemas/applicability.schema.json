{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "obligations"
  ],
  "properties": {
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "N_A",
              "PASS",
              "DEFERRED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "revisit_trigger": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
