{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/protocol-adapter/1.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "protocol",
    "versions",
    "identity_mapping",
    "storage_access"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_mapping": {
      "enum": [
        "OPAQUE_EXTERNAL_REF",
        "INGEST_VERIFIED_COPY"
      ]
    },
    "storage_access": {
      "const": "PUBLIC_PORT_ONLY"
    },
    "declared_capability_semantics": {
      "const": "DECLARED_NOT_MEASURED"
    }
  }
}
