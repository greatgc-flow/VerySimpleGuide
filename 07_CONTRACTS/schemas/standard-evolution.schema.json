{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/standard-evolution/1.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "kind",
    "affected_controls",
    "coverage_gap",
    "alternatives",
    "migration_plan",
    "verification",
    "owner",
    "status",
    "review_trigger"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "ADD",
        "SPLIT",
        "MERGE",
        "RECLASSIFY",
        "DEPRECATE",
        "RETIRE"
      ]
    },
    "affected_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "coverage_gap": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "migration_plan": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "EXPERIMENT",
        "APPROVED",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
