{
  "standard_id": "VS-UNIFIED-PACKAGE-STANDARD",
  "version": "1.9.5",
  "philosophy": "semantic standardization first; syntactic sameness only when it reduces total complexity",
  "planes": [
    "PRODUCT_RUNTIME",
    "DELIVERY"
  ],
  "component_classes": [
    "CORE",
    "MODULE",
    "EXTENSION",
    "GENERATED_VIEW",
    "EXTERNAL"
  ],
  "boundary_roles": [
    "NONE",
    "ADAPTER",
    "PROVIDER",
    "EXPORTER"
  ],
  "state_kinds": [
    "CONFIG",
    "DOMAIN_DATA",
    "EVIDENCE",
    "LOG",
    "CACHE",
    "TEMP",
    "BACKUP",
    "SCHEMA",
    "SECRET",
    "EXTERNAL_REF"
  ],
  "recovery_classes": [
    "AUTHORITATIVE",
    "DURABLE_DERIVED",
    "REBUILDABLE",
    "EPHEMERAL",
    "EXTERNAL"
  ],
  "maturity": [
    "PLANNED",
    "DESIGN_FROZEN",
    "IMPLEMENTING",
    "IMPLEMENTED",
    "VERIFIED",
    "DEPRECATED",
    "RETIRED"
  ],
  "distribution": [
    "NOT_PUBLISHED",
    "CANDIDATE",
    "PUBLISHED",
    "PROMOTED",
    "WITHDRAWN"
  ],
  "applicability": [
    "REQUIRED",
    "OPTIONAL",
    "N_A"
  ],
  "approach": [
    "COMPLY",
    "ADAPT",
    "PRODUCT_SPECIFIC"
  ],
  "assessment_results": [
    "NOT_EVALUATED",
    "PASS",
    "FAIL"
  ],
  "feedback_dispositions": [
    "PENDING",
    "ACCEPT",
    "REJECT",
    "DEFER",
    "DUPLICATE"
  ],
  "feedback_statuses": [
    "OPEN",
    "IN_PROGRESS",
    "CLOSED"
  ],
  "feedback_events": [
    "CLOSE",
    "REOPEN"
  ],
  "legacy_feature_strategies": [
    "RETAIN",
    "ABSORB",
    "SUPERSEDE",
    "EXTRACT_EXTENSION",
    "RETIRE"
  ],
  "exit_semantics": [
    "SUCCESS",
    "USAGE",
    "DECLINED",
    "PRECONDITION_FAILED",
    "BLOCKED",
    "VERIFICATION_FAILED",
    "ROLLED_BACK",
    "RUNTIME_FAILED",
    "INTERNAL_ERROR"
  ],
  "value_semantics": [
    "ABSENT",
    "NULL",
    "EMPTY_STRING",
    "EMPTY_ARRAY",
    "UNKNOWN"
  ],
  "controls": [
    {
      "id": "UPS-CLI",
      "name": "CLI / Interface",
      "standard_refs": [
        "02_STANDARD/CLI_STANDARD.md"
      ],
      "verification_obligation": "Verify public interface side-effect boundaries, help and stable machine output.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-HELP",
      "name": "Help / Discoverability",
      "standard_refs": [
        "02_STANDARD/CLI_STANDARD.md"
      ],
      "verification_obligation": "Verify root and subcommand discovery are read-only and accessible.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-EXIT",
      "name": "Exit Semantics",
      "standard_refs": [
        "02_STANDARD/CLI_STANDARD.md"
      ],
      "verification_obligation": "Negative-test semantic exit classes for success, usage, refusal and blocked operations.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-CONFIG",
      "name": "Configuration",
      "standard_refs": [
        "02_STANDARD/CONFIG_STATE_SCHEMA.md",
        "02_STANDARD/CAPABILITY_CATALOG_STANDARD.md"
      ],
      "verification_obligation": "Verify precedence, merge semantics and absent/null/empty/UNKNOWN cases.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-LAYOUT",
      "name": "State / Filesystem",
      "standard_refs": [
        "02_STANDARD/CONFIG_STATE_SCHEMA.md",
        "02_STANDARD/DATA_SAFETY_STANDARD.md",
        "02_STANDARD/AUTHORITY_PROJECTION_STANDARD.md"
      ],
      "verification_obligation": "Verify authority ownership, projection reconstruction and recovery safety.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-SCHEMA",
      "name": "Schema / Version",
      "standard_refs": [
        "02_STANDARD/CONFIG_STATE_SCHEMA.md",
        "02_STANDARD/CAPABILITY_CATALOG_STANDARD.md",
        "02_STANDARD/UNIFIED_STANDARD.md"
      ],
      "verification_obligation": "Validate schemas and incompatible versions with positive and negative cases.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-COMP",
      "name": "Component Boundary",
      "standard_refs": [
        "02_STANDARD/COMPONENT_BOUNDARY.md",
        "02_STANDARD/UNIFIED_STANDARD.md",
        "02_STANDARD/INTEROPERABILITY_NEUTRALITY.md",
        "02_STANDARD/KNOWLEDGE_REFERENCE_STANDARD.md"
      ],
      "verification_obligation": "Validate component ownership, forbidden dependency edges and core-only behavior.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-EXT",
      "name": "Extension / Boundary",
      "standard_refs": [
        "02_STANDARD/EXTENSION_PROVIDER_STANDARD.md",
        "02_STANDARD/PROVIDER_CAPABILITY_STANDARD.md",
        "02_STANDARD/PROTOCOL_ADAPTER_STANDARD.md",
        "02_STANDARD/INTEROPERABILITY_NEUTRALITY.md",
        "02_STANDARD/CAPABILITY_CATALOG_STANDARD.md"
      ],
      "verification_obligation": "Verify extension boundaries, failure isolation and disable behavior.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-OBS",
      "name": "Observation / Diagnostics",
      "standard_refs": [
        "02_STANDARD/OBSERVABILITY_EVIDENCE_STANDARD.md",
        "02_STANDARD/AUTHORITY_PROJECTION_STANDARD.md",
        "02_STANDARD/CAPABILITY_CATALOG_STANDARD.md"
      ],
      "verification_obligation": "Verify telemetry provenance, freshness and read-only observation.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-EVID",
      "name": "Evidence",
      "standard_refs": [
        "02_STANDARD/OBSERVABILITY_EVIDENCE_STANDARD.md",
        "04_ASSURANCE/ASSURANCE_CASE_AND_NEGATIVE_TEST.md",
        "02_STANDARD/KNOWLEDGE_REFERENCE_STANDARD.md"
      ],
      "verification_obligation": "Verify candidate identity, evidence chain, timestamps and feedback closure.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-SEC",
      "name": "Security / Trust",
      "standard_refs": [
        "02_STANDARD/SECURITY_TRUST_STANDARD.md"
      ],
      "verification_obligation": "Verify security boundaries, least privilege and adversarial failure cases.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-MIG",
      "name": "Migration / Compatibility",
      "standard_refs": [
        "02_STANDARD/COMPATIBILITY_MIGRATION_STANDARD.md",
        "03_LIFECYCLE/CUTOVER_ROLLBACK.md",
        "02_STANDARD/LIFECYCLE_COVERAGE_STANDARD.md"
      ],
      "verification_obligation": "Test migration, compatibility, rollback and retirement obligations.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-TEST",
      "name": "Assurance",
      "standard_refs": [
        "02_STANDARD/LIFECYCLE_COVERAGE_STANDARD.md",
        "04_ASSURANCE/ASSURANCE_CASE_AND_NEGATIVE_TEST.md",
        "01_METHOD/OPERATIONAL_FEEDBACK_LOOP.md",
        "02_STANDARD/INTEROPERABILITY_NEUTRALITY.md"
      ],
      "verification_obligation": "Verify risk-based tests, negative cases, traceability and independent acceptance.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-REL",
      "name": "Release / Promotion",
      "standard_refs": [
        "02_STANDARD/RELEASE_PROMOTION_STANDARD.md"
      ],
      "verification_obligation": "Verify build-once release identity, fresh gates and identical artifact promotion.",
      "assurance_level": "DESIGN_COVERED"
    },
    {
      "id": "UPS-DOC",
      "name": "Documentation / SSOT",
      "standard_refs": [
        "02_STANDARD/UNIFIED_STANDARD.md",
        "02_STANDARD/KNOWLEDGE_REFERENCE_STANDARD.md",
        "02_STANDARD/INTEROPERABILITY_NEUTRALITY.md",
        "02_STANDARD/LIFECYCLE_COVERAGE_STANDARD.md"
      ],
      "verification_obligation": "Verify SSOT-generated views, objective/fitness ownership and source link accuracy.",
      "assurance_level": "DESIGN_COVERED"
    }
  ],
  "invariants": [
    "core_must_not_depend_on_optional_extensions",
    "base_scope_survives_with_all_optional_extensions_disabled",
    "boundary_roles_are_orthogonal_to_component_class",
    "state_kind_is_orthogonal_to_recovery_class",
    "maturity_is_orthogonal_to_distribution",
    "unknown_must_not_be_silently_promoted_to_positive_fact",
    "derived_projection_must_be_rebuildable_when_classified_rebuildable",
    "external_protocol_identity_must_not_be_internal_identity",
    "declared_capability_is_not_measured_capability",
    "routing_selects_orchestration_executes",
    "orchestration_must_be_bounded",
    "uncertain_execution_must_not_be_blindly_retried",
    "approval_binds_to_exact_effect",
    "build_once_and_promote_same_artifact",
    "blocking_gate_requires_fresh_exact_candidate_pass",
    "public_cutover_is_separate_from_implementation_maturity",
    "human_views_must_not_drift_from_machine_ssot",
    "procedure_source_generated_index_catalog_policy_are_distinct",
    "volatile_measured_fact_belongs_to_observation_not_static_catalog",
    "provider_specific_behavior_is_selected_by_capability_not_core_vendor_branch",
    "projection_results_must_expose_freshness_or_watermark_when_staleness_matters",
    "transport_connection_lifetime_must_not_define_domain_identity",
    "feedback_must_link_observation_to_disposition_and_revisit_or_outcome",
    "accepted_feedback_requires_requirement_test_and_gate_trace",
    "closed_feedback_requires_post_release_outcome_evidence",
    "general_package_validation_does_not_imply_product_runtime_verified",
    "technology_choice_is_product_local_not_general_mandated",
    "normative_invariant_and_design_heuristic_are_separate",
    "innovative_alternative_has_bounded_falsifiable_evidence_path",
    "control_and_taxonomy_evolution_is_versioned_not_forbidden",
    "conformance_may_be_proved_by_equivalent_non_reference_tool",
    "lifecycle_stages_have_outcome_owner_exit_and_revisit",
    "each_lifecycle_crosscut_concern_has_explicit_applicability",
    "optional_guidance_requires_project_adoption_to_become_normative",
    "reference_catalog_preserves_source_status_and_review_trigger",
    "retirement_must_consider_access_data_and_residual_obligations",
    "knowledge_selection_must_keep_alternatives_and_avoid_conditions"
  ],
  "outcome_contract": {
    "objective_required": true,
    "scope_and_non_goals_required": true,
    "fitness_measures_or_unratified_required": true,
    "feedback_post_release_evaluation_required": true,
    "evidence_to_regression_test_trace_required": true,
    "claim_kinds": [
      "DESIGN_COVERED",
      "SCHEMA_CHECKED",
      "NEGATIVE_TESTED",
      "PRODUCT_VERIFIED"
    ],
    "claim_results": [
      "NOT_EVALUATED",
      "PASS",
      "FAIL"
    ]
  },
  "openness_contract": {
    "language_agnostic": true,
    "platform_agnostic": true,
    "reference_tool_non_normative": true,
    "baseline_controls_not_immutable": true,
    "innovation_proposals_supported": true,
    "normative_levels": [
      "INVARIANT",
      "DEFAULT_HEURISTIC",
      "EXAMPLE_REFERENCE"
    ]
  },
  "lifecycle_contract": {
    "model": "12 logical stages x 10 crosscut concerns",
    "stage_matrix": "03_LIFECYCLE/lifecycle-matrix.json",
    "product_checklist": "07_CONTRACTS/examples/project-lifecycle.example.json",
    "not_a_waterfall": true,
    "stage_applicability_product_local": true,
    "stage_owners_and_exit_required_when_applicable": true,
    "retirement_and_revisit_covered": true
  },
  "guidance_contract": {
    "mode": "OPTIONAL_PULL_ON_DEMAND",
    "catalog": "08_KNOWLEDGE/guidance-catalog.json",
    "references": "08_KNOWLEDGE/references/catalog.json",
    "not_normative_by_default": true,
    "reference_tool_non_normative": true,
    "requires_adoption_record_for_mandate": true
  }
}
