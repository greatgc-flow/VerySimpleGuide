{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/implementation-choice/1.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "scope",
    "candidate",
    "alternatives",
    "criteria",
    "evidence_plan",
    "decision",
    "review_trigger"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "array",
          "object",
          "null",
          "number",
          "boolean"
        ]
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_plan": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "PROPOSED",
        "EXPERIMENT",
        "ADOPT",
        "DEFER",
        "REJECT",
        "RETIRE"
      ]
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "benchmark_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "project_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "feedback_id": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ADOPT"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "decision_owner",
          "rollback_plan",
          "project_id",
          "feedback_id"
        ],
        "properties": {
          "decision_owner": {
            "type": "string",
            "pattern": "\\S"
          },
          "rollback_plan": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "anyOf": [
          {
            "required": [
              "decision_evidence_refs"
            ]
          },
          {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        ]
      }
    }
  ]
}
