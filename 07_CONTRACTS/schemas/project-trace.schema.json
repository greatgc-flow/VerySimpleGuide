{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/project-trace/1.9",
  "title": "Project Feedback and Traceability Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_version",
    "project_id",
    "objective",
    "requirements",
    "tests",
    "gates",
    "observations",
    "feedback",
    "changes",
    "releases"
  ],
  "properties": {
    "standard_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "owner",
        "success_measures",
        "non_goals"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_measures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "definition",
              "target",
              "method",
              "baseline_status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "baseline_status": {
                "enum": [
                  "MEASURED",
                  "UNRATIFIED",
                  "UNKNOWN"
                ]
              },
              "baseline_evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "baseline_status": {
                      "const": "MEASURED"
                    }
                  },
                  "required": [
                    "baseline_status"
                  ]
                },
                "then": {
                  "required": [
                    "baseline_evidence_refs"
                  ],
                  "properties": {
                    "baseline_evidence_refs": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "acceptance",
          "scope",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_ids",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "red_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "accepted_red_exception_ref": {
            "type": "string",
            "minLength": 1
          },
          "candidate_identity": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact_digest": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "candidate_identity",
                "artifact_digest",
                "observed_at"
              ],
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "gate-evidence.schema.json"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "candidate_identity",
          "observed_at",
          "evidence_refs",
          "finding",
          "metric_id",
          "evaluation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "SOURCE",
              "POST_RELEASE_OUTCOME"
            ]
          },
          "candidate_identity": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "evaluation": {
            "enum": [
              "MEETS_TARGET",
              "MISSES_TARGET",
              "UNKNOWN",
              "EXCEPTION_ACCEPTED"
            ]
          }
        }
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observation_id",
          "owner",
          "priority",
          "status",
          "disposition",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "CLOSED"
            ]
          },
          "disposition": {
            "enum": [
              "PENDING",
              "ACCEPT",
              "REJECT",
              "DEFER",
              "DUPLICATE"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "decision_ref": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "revisit_trigger": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "closure_gate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "closure_candidate_identity": {
            "type": "string",
            "minLength": 1
          },
          "outcome_observation_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome_decision": {
            "enum": [
              "MEETS_TARGET",
              "EXCEPTION_ACCEPTED"
            ]
          },
          "release_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event",
                "at",
                "actor",
                "reason"
              ],
              "properties": {
                "event": {
                  "enum": [
                    "CLOSE",
                    "REOPEN"
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "prior_closure_evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "closure_evidence_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "observation_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "event": {
                        "const": "REOPEN"
                      }
                    },
                    "required": [
                      "event"
                    ]
                  },
                  "then": {
                    "required": [
                      "decision_ref",
                      "prior_closure_evidence_ref"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "event": {
                        "const": "CLOSE"
                      }
                    },
                    "required": [
                      "event"
                    ]
                  },
                  "then": {
                    "required": [
                      "closure_evidence_ref"
                    ]
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "OPEN",
                    "IN_PROGRESS"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "next_action"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "DEFER"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "revisit_trigger",
                "decision_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "REJECT",
                    "DUPLICATE"
                  ]
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "decision_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CLOSED"
                },
                "disposition": {
                  "const": "ACCEPT"
                }
              },
              "required": [
                "status",
                "disposition"
              ]
            },
            "then": {
              "required": [
                "decision_ref",
                "requirement_ids",
                "test_ids",
                "closure_gate_ids",
                "closure_candidate_identity",
                "outcome_observation_id",
                "outcome_decision",
                "release_evidence_ref"
              ],
              "properties": {
                "requirement_ids": {
                  "minItems": 1
                },
                "test_ids": {
                  "minItems": 1
                },
                "closure_gate_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CLOSED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "history",
                "revisit_trigger"
              ],
              "properties": {
                "history": {
                  "minItems": 1
                },
                "revisit_trigger": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "candidate_identity",
          "artifact_digest",
          "artifact_refs",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "candidate_identity": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact_digest": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "candidate_identity",
          "artifact_digest",
          "from",
          "to",
          "released_at",
          "decision_ref",
          "evidence_refs",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "candidate_identity": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact_digest": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "from": {
            "enum": [
              "NOT_PUBLISHED",
              "CANDIDATE",
              "PUBLISHED",
              "PROMOTED",
              "WITHDRAWN"
            ]
          },
          "to": {
            "enum": [
              "NOT_PUBLISHED",
              "CANDIDATE",
              "PUBLISHED",
              "PROMOTED",
              "WITHDRAWN"
            ]
          },
          "released_at": {
            "type": "string",
            "format": "date-time"
          },
          "decision_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "change_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "gate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "notice_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "recovery_obligations": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "deployment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_identity",
              "artifact_digest",
              "deployed_at",
              "evidence_refs"
            ],
            "properties": {
              "candidate_identity": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "artifact_digest": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "deployed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "to": {
                  "const": "PUBLISHED"
                }
              },
              "required": [
                "to"
              ]
            },
            "then": {
              "required": [
                "limitations",
                "change_ids",
                "deployment"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "to": {
                  "const": "PROMOTED"
                }
              },
              "required": [
                "to"
              ]
            },
            "then": {
              "required": [
                "change_ids",
                "gate_ids",
                "deployment"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "to": {
                  "const": "WITHDRAWN"
                }
              },
              "required": [
                "to"
              ]
            },
            "then": {
              "required": [
                "reason",
                "notice_ref",
                "recovery_obligations"
              ]
            }
          }
        ]
      }
    }
  }
}
