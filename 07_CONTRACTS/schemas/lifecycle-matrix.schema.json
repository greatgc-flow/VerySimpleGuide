{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verysimple/lifecycle-matrix/1.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id",
    "version",
    "profile_rules",
    "concerns",
    "stages"
  ],
  "properties": {
    "matrix_id": {
      "const": "VS-LIFECYCLE-12X10"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "baseline_semantics": {
      "type": "string"
    },
    "profile_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compact_mandatory_stages",
        "compact_mandatory_concerns",
        "escalation_flags",
        "activity_flag_stages",
        "exposure_flag_concerns"
      ],
      "properties": {
        "compact_mandatory_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compact_mandatory_concerns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "escalation_flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "activity_flag_stages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "exposure_flag_concerns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "concerns": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "primary_control",
          "reference_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "primary_control": {
            "type": "string",
            "pattern": "^UPS-[A-Z]+$"
          },
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "objective",
          "minimum_output",
          "exit_decision",
          "primary_control",
          "next_stages",
          "revisit_stages",
          "reference_ids",
          "coverage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "minimum_output": {
            "type": "string",
            "minLength": 1
          },
          "exit_decision": {
            "type": "string",
            "minLength": 1
          },
          "primary_control": {
            "type": "string",
            "pattern": "^UPS-[A-Z]+$"
          },
          "next_stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "revisit_stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object",
            "minProperties": 10,
            "additionalProperties": {
              "enum": [
                "FOCUS",
                "CONSIDER"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
